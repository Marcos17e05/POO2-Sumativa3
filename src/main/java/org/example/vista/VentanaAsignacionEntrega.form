<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.example.vista.VentanaAsignacionEntrega">
  <grid id="panelEntregaRoot" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="10">
    <margin top="18" left="20" bottom="18" right="20"/>
    <constraints>
      <xy x="20" y="20" width="980" height="650"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="tituloEntregas" class="javax.swing.JLabel" binding="lblTitulo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Segoe UI" size="20" style="1"/>
          <text value="Gestión de entregas"/>
        </properties>
      </component>
      <grid id="panelDatosEntrega" layout-manager="GridLayoutManager" row-count="5" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="8">
        <margin top="2" left="0" bottom="2" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="etiquetaIdEntrega" class="javax.swing.JLabel" binding="lblId">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="ID:"/>
            </properties>
          </component>
          <component id="campoIdEntrega" class="javax.swing.JTextField" binding="txtId">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="600" height="30"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="etiquetaPedidoEntrega" class="javax.swing.JLabel" binding="lblPedido">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Pedido:"/>
            </properties>
          </component>
          <component id="comboPedidoEntrega" class="javax.swing.JComboBox" binding="cmbPedido">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="etiquetaRepartidorEntrega" class="javax.swing.JLabel" binding="lblRepartidor">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Repartidor:"/>
            </properties>
          </component>
          <component id="comboRepartidorEntrega" class="javax.swing.JComboBox" binding="cmbRepartidor">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="etiquetaFechaEntrega" class="javax.swing.JLabel" binding="lblFecha">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Fecha:"/>
            </properties>
          </component>
          <component id="campoFechaEntrega" class="javax.swing.JTextField" binding="txtFecha">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="etiquetaHoraEntrega" class="javax.swing.JLabel" binding="lblHora">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Hora:"/>
            </properties>
          </component>
          <component id="campoHoraEntrega" class="javax.swing.JTextField" binding="txtHora">
            <constraints>
              <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
        </children>
      </grid>
      <grid id="panelAccionesEntrega" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="0">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="btnRegistrarEntregaForm" class="javax.swing.JButton" binding="btnGuardar">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Registrar"/>
            </properties>
          </component>
          <component id="btnEliminarEntregaForm" class="javax.swing.JButton" binding="btnEliminar">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Eliminar"/>
            </properties>
          </component>
          <component id="btnLimpiarEntregaForm" class="javax.swing.JButton" binding="btnLimpiar">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Limpiar Texto"/>
            </properties>
          </component>
          <component id="btnActualizarEntregaForm" class="javax.swing.JButton" binding="btnActualizar">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Actualizar"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="panelListadoEntregas" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="8">
        <margin top="4" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="panelFiltrosEntrega" layout-manager="GridLayoutManager" row-count="2" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="6" vgap="0">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="etiquetaFiltroPedidoEntrega" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Pedido:"/>
                </properties>
              </component>
              <component id="comboFiltroPedidoEntrega" class="javax.swing.JComboBox" binding="cmbFiltroPedido">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="220" height="30"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="btnAplicarFiltroEntrega" class="javax.swing.JButton" binding="btnFiltrar">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Aplicar filtros"/>
                </properties>
              </component>
              <component id="btnRefrescarEntregaForm" class="javax.swing.JButton" binding="btnRefrescar">
                <constraints>
                  <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Refrescar"/>
                </properties>
              </component>
              <component id="etiquetaFiltroRepartidorEntrega" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Repartidor:"/>
                </properties>
              </component>
              <component id="comboFiltroRepartidorEntrega" class="javax.swing.JComboBox" binding="cmbFiltroRepartidor">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="180" height="30"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
            </children>
          </grid>
          <scrollpane id="scrollTablaEntregas">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="900" height="280"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="tablaEntregasForm" class="javax.swing.JTable" binding="tblEntregas">
                <constraints/>
                <properties/>
              </component>
            </children>
          </scrollpane>
        </children>
      </grid>
    </children>
  </grid>
</form>
