<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.example.vista.VentanaPrincipal">
  <grid id="panelPrincipalRoot" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="7" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="10">
    <margin top="24" left="36" bottom="24" right="36"/>
    <constraints>
      <xy x="20" y="20" width="560" height="420"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="tituloPrincipal" class="javax.swing.JLabel" binding="lblTitulo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Segoe UI" size="24" style="1"/>
          <text value="SpeedFast"/>
        </properties>
      </component>
      <component id="subtituloPrincipal" class="javax.swing.JLabel" binding="lblSubtitulo">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Sistema de gestión de pedidos y entregas"/>
        </properties>
      </component>
      <vspacer id="espacioSuperior">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
      <component id="botonPedidos" class="javax.swing.JButton" binding="btnRegistrarPedido">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="360" height="46"/>
          </grid>
        </constraints>
        <properties>
          <text value="Gestión de pedidos"/>
        </properties>
      </component>
      <component id="botonRepartidores" class="javax.swing.JButton" binding="btnRegistrarRepartidor">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="360" height="46"/>
          </grid>
        </constraints>
        <properties>
          <text value="Gestión de repartidores"/>
        </properties>
      </component>
      <component id="botonEntregas" class="javax.swing.JButton" binding="btnAsignarEntrega">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="360" height="46"/>
          </grid>
        </constraints>
        <properties>
          <text value="Gestión de entregas"/>
        </properties>
      </component>
      <component id="botonListado" class="javax.swing.JButton" binding="btnListarPedidos">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="360" height="46"/>
          </grid>
        </constraints>
        <properties>
          <text value="Mostrar listado"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
