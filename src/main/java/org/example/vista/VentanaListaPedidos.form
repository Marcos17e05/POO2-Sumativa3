<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.example.vista.VentanaListaPedidos">
  <grid id="panelListadoGeneralRoot" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="10">
    <margin top="18" left="20" bottom="18" right="20"/>
    <constraints>
      <xy x="20" y="20" width="920" height="520"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="tituloListadoGeneral" class="javax.swing.JLabel" binding="lblTitulo">
        <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties>
          <font name="Segoe UI" size="20" style="1"/>
          <text value="Listado general"/>
        </properties>
      </component>
      <grid id="panelSelectorListado" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="0">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="etiquetaMostrarListado" class="javax.swing.JLabel" binding="lblMostrar">
            <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
            <properties><text value="Mostrar:"/></properties>
          </component>
          <component id="comboListadoGeneral" class="javax.swing.JComboBox" binding="cmbListado">
            <constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"><preferred-size width="250" height="30"/></grid></constraints>
            <properties/>
          </component>
          <component id="btnRefrescarListadoGeneral" class="javax.swing.JButton" binding="btnRefrescar">
            <constraints><grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"><preferred-size width="150" height="30"/></grid></constraints>
            <properties><text value="Refrescar"/></properties>
          </component>
        </children>
      </grid>
      <scrollpane id="scrollListadoGeneral">
        <constraints><grid row="2" column="0" row-span="2" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="860" height="360"/></grid></constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="tablaListadoGeneral" class="javax.swing.JTable" binding="tblDatos">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
