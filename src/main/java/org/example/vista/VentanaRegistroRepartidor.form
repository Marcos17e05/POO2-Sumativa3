<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.example.vista.VentanaRegistroRepartidor">
  <grid id="panelRepartidorRoot" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="10" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="10">
    <margin top="20" left="20" bottom="20" right="20"/>
    <constraints>
      <xy x="20" y="20" width="785" height="500"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="tituloRepartidores" class="javax.swing.JLabel" binding="lblTitulo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Segoe UI" size="20" style="1"/>
          <text value="Gestión de repartidores"/>
        </properties>
      </component>
      <grid id="panelDatosRepartidor" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="0">
        <margin top="4" left="0" bottom="4" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="2" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="etiquetaNombreRepartidor" class="javax.swing.JLabel" binding="lblNombre">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Nombre:"/>
            </properties>
          </component>
          <component id="campoNombreRepartidor" class="javax.swing.JTextField" binding="txtNombre">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="460" height="30"/>
              </grid>
            </constraints>
            <properties/>
          </component>
        </children>
      </grid>
      <scrollpane id="scrollTablaRepartidores">
        <constraints>
          <grid row="3" column="0" row-span="6" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="650" height="280"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="tablaRepartidoresForm" class="javax.swing.JTable" binding="tblRepartidores">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="btnRefrescarRepartidoresForm" class="javax.swing.JButton" binding="btnRefrescar">
        <constraints>
          <grid row="9" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="180" height="34"/>
          </grid>
        </constraints>
        <properties>
          <text value="Refrescar tabla"/>
        </properties>
      </component>
      <component id="btnRegistrarRepartidorForm" class="javax.swing.JButton" binding="btnGuardar">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Registrar"/>
        </properties>
      </component>
      <component id="btnActualizarRepartidorForm" class="javax.swing.JButton" binding="btnActualizar">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Actualizar"/>
        </properties>
      </component>
      <component id="btnEliminarRepartidorForm" class="javax.swing.JButton" binding="btnEliminar">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Eliminar"/>
        </properties>
      </component>
      <component id="btnLimpiarRepartidorForm" class="javax.swing.JButton" binding="btnLimpiar">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Limpiar Texto"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
